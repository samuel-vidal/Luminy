{
  "name": "luminy-react",
  "version": "0.1.0",
  "description": "Pure vector mathematical plotting library for React — zero external graphics dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./node_modules/tsup/dist/cli-default.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "svg",
    "charts",
    "plotting",
    "scientific",
    "zero-dependency",
    "ssr"
  ],
  "author": "Samuel Vidal",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
