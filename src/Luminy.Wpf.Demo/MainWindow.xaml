<Window x:Class="Luminy.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Luminy.Wpf.Demo"
        xmlns:luminy="clr-namespace:Luminy.Wpf;assembly=Luminy.Wpf"
        mc:Ignorable="d"
        Title="Luminy.Wpf — DirectX Retained-Mode Showcase" Height="750" Width="1100"
        Background="#F8FAFC">
    
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Controls -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
            <StackPanel>
                <TextBlock Text="Luminy.Wpf Demo" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Hardware-accelerated DirectX plotting" FontSize="12" Foreground="#64748B" Margin="0,4,0,24" />

                <TextBlock Text="Frequency (rad/s)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="6.0" Value="{Binding Frequency, Mode=TwoWay}" SmallChange="0.1" LargeChange="0.5" />
                <TextBlock Text="{Binding Frequency, StringFormat='{}{0:F1} rad/s'}" Foreground="#64748B" FontSize="11" Margin="0,2,0,16" />

                <TextBlock Text="Amplitude" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                <Slider Minimum="0.2" Maximum="3.0" Value="{Binding Amplitude, Mode=TwoWay}" SmallChange="0.1" LargeChange="0.5" />
                <TextBlock Text="{Binding Amplitude, StringFormat='{}{0:F2}'}" Foreground="#64748B" FontSize="11" Margin="0,2,0,16" />

                <TextBlock Text="Noise Level" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Noise, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.2" />
                <TextBlock Text="{Binding Noise, StringFormat='{}{0:F2}'}" Foreground="#64748B" FontSize="11" Margin="0,2,0,24" />

                <CheckBox Content="Show Grid" IsChecked="{Binding ShowGrid}" Margin="0,0,0,12" />
                <CheckBox Content="Show Legend" IsChecked="{Binding ShowLegend}" Margin="0,0,0,12" />
            </StackPanel>
        </Border>

        <!-- Visual Displays Area -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- LinePlot Display -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <luminy:Display Title="Dynamic Harmonic Spectrum"
                                XLabel="Time (s)"
                                YLabel="Signal Voltage (V)"
                                ShowGrid="{Binding ShowGrid}"
                                ShowLegend="{Binding ShowLegend}">
                    <luminy:LinePlot X="{Binding TimePoints}" Y="{Binding NoisySignal}" Label="Sensor Raw (Noisy)" StrokeThickness="1.5" Color="#FF94A3B8" />
                    <luminy:LinePlot X="{Binding TimePoints}" Y="{Binding SineSignal}" Label="Fundamental Sin(ωt)" StrokeThickness="2.5" Color="#FF0284C7" />
                    <luminy:LinePlot X="{Binding TimePoints}" Y="{Binding CosineSignal}" Label="Phase Cos(ωt)" StrokeThickness="2.0" Color="#FFF97316" />
                </luminy:Display>
            </Border>

            <!-- DonutPlot Display -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <luminy:Display Title="Platform Resource Distribution"
                                AxesStyle="None"
                                ShowGrid="False"
                                ShowLegend="{Binding ShowLegend}">
                    <luminy:DonutPlot Values="{Binding DonutValues}"
                                      Labels="{Binding DonutLabels}"
                                      InsideValueDisplay="Percent"
                                      ExternalRadius="1.0"
                                      InternalRadius="0.6" />
                </luminy:Display>
            </Border>
        </Grid>
    </Grid>
</Window>
