<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Luminy.Wpf</PackageId>
    <Version>1.0.0</Version>
    <Authors>Samuel Vidal</Authors>
    <Description>Enterprise-grade retained-mode WPF plotting controls for .NET 9 — DirectX hardware-accelerated vector graphics.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luminy\Luminy.csproj" />
  </ItemGroup>

</Project>
